# Copie para ".env" (ignorado pelo Git) e ajuste se necessário.
# Os valores abaixo são apenas para desenvolvimento local.
DB_USER=ativos
DB_PASSWORD=ativos
DB_ROOT_PASSWORD=root
# Porta do MySQL exposta no seu Mac (evita conflito com um MySQL local na 3306)
MYSQL_HOST_PORT=3307
# Origens permitidas pelo gateway (CORS), separadas por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:3000
